# The base image every TypeScript corpus runs in: node runs the test runner,
# bun runs the task face the build recipes are named on, and the toolchain
# sits at /node_modules, where the repository's bind mount at /workspace
# cannot cover it and node's upward resolution still finds it from any
# working directory.
#
# Both bases are pinned by digest, never by tag: a tag is a moving name, and
# an image that moves underneath a budget turns every verdict into a
# measurement of whoever pushed last. The digests are the registry's manifest
# lists, read from the first entry of the engine's `inspect --format
# '{{.RepoDigests}}'` after pulling docker.io/oven/bun:1.3.13-debian (bun
# 1.3.13) and docker.io/library/node:22-bookworm-slim (node 22.23.2), so one
# reference resolves on every architecture the list carries.
FROM docker.io/oven/bun@sha256:550178b0d9fefc73c8758eb1ee9bb7eff90747ba1008d80a5bb76695b3fd9265 AS bun

FROM docker.io/library/node@sha256:a17d50af28002a160548bd4225b3cfcb12c5efcb171f79e68758f2885fb1b066

COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun

# The manifest and the lockfile beside this file name the toolchain at exact
# versions, and the install is frozen to the lockfile, so the image is a
# function of those two files and of nothing the registry served on the day.
# The build context is the repository root, which is why the paths carry the
# directory.
#
# The build is asked for a fixed timestamp, and that is what makes the digest
# of this definition reproduce. A layer archive carries the modification time
# of every file in it, so two builds of these same lines minutes apart differ
# in bytes and hash to two digests; dated at one instant they are identical.
# It is the reason a corpus can pin an image it builds itself.
WORKDIR /
COPY images/ts/package.json images/ts/bun.lock /
RUN bun install --frozen-lockfile && rm -rf /root/.bun/install/cache

# Read by the runner and by the formatter; both drop their interactive
# affordances.
ENV CI=true

# What the registry links the image to.
LABEL org.opencontainers.image.source="https://github.com/advl/guarantees"

WORKDIR /workspace
