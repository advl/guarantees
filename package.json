{
  "name": "@aztlan/guarantees",
  "description": "The scheduler for a repository's guarantees: a register of rows, each run in a digest-pinned container under the repository's own test runner, and a verdict",
  "version": "0.0.0",
  "type": "module",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "author": {
    "email": "47156835+advl@users.noreply.github.com",
    "name": "advl"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/advl/guarantees"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/advl/guarantees/issues"
  },
  "homepage": "https://github.com/advl/guarantees#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "bun run build && bun run check:biome && bun run check:ts && bun run check:leakage && bun run check:webarchitect",
    "check:fix": "bun run check:biome:fix && bun run check:ts",
    "check:biome": "biome check",
    "check:biome:fix": "biome check --write",
    "check:ts": "tsc --noEmit",
    "check:webarchitect": "webarchitect library --license MIT --prefix '@aztlan/'",
    "check:leakage": "bun scripts/check-leakage.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "ci": "bun run check && bun run test:coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "@canonical/biome-config": "0.33.0",
    "@canonical/typescript-config": "0.33.0",
    "@canonical/webarchitect": "0.33.0",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
